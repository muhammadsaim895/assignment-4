{
	"info": {
		"_postman_id": "b6e1a2b0-4f7d-4e9a-9d3a-1a2b3c4d5e6f",
		"name": "JSONPlaceholder API Testing - Assignment 4",
		"description": "API testing collection for JSONPlaceholder REST API covering GET, POST, PUT, and DELETE requests with automated Postman tests validating status codes, response time, response structure, and field values.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. GET Requests",
			"item": [
				{
					"name": "GET All Posts",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/posts",
							"host": ["{{baseUrl}}"],
							"path": ["posts"]
						},
						"description": "Retrieves the full list of posts."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response time is less than 1000ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(1000);",
									"});",
									"",
									"pm.test(\"Response is an array\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"});",
									"",
									"pm.test(\"Array is not empty and contains 100 posts\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.length).to.eql(100);",
									"});",
									"",
									"pm.test(\"Each post has required fields\", function () {",
									"    const jsonData = pm.response.json();",
									"    const firstPost = jsonData[0];",
									"    pm.expect(firstPost).to.have.property('userId');",
									"    pm.expect(firstPost).to.have.property('id');",
									"    pm.expect(firstPost).to.have.property('title');",
									"    pm.expect(firstPost).to.have.property('body');",
									"});",
									"",
									"pm.test(\"Content-Type header is application/json\", function () {",
									"    pm.response.to.have.header(\"Content-Type\");",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET Single Post (id=1)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/posts/1",
							"host": ["{{baseUrl}}"],
							"path": ["posts", "1"]
						},
						"description": "Retrieves a single post with id = 1."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response time is less than 800ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(800);",
									"});",
									"",
									"pm.test(\"Response has correct structure\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('object');",
									"    pm.expect(jsonData).to.have.all.keys('userId', 'id', 'title', 'body');",
									"});",
									"",
									"pm.test(\"id field equals 1\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.eql(1);",
									"});",
									"",
									"pm.test(\"title field is a non-empty string\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.title).to.be.a('string').and.to.have.lengthOf.above(0);",
									"});",
									"",
									"pm.test(\"body field is a non-empty string\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.body).to.be.a('string').and.to.have.lengthOf.above(0);",
									"});",
									"",
									"pm.test(\"userId field is a number\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.userId).to.be.a('number');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET Non-Existent Post (id=99999)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/posts/99999",
							"host": ["{{baseUrl}}"],
							"path": ["posts", "99999"]
						},
						"description": "Negative test: requests a post that does not exist."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 404 for non-existent resource\", function () {",
									"    pm.response.to.have.status(404);",
									"});",
									"",
									"pm.test(\"Response time is less than 800ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(800);",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "2. POST Requests",
			"item": [
				{
					"name": "POST Create New Post",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"foo\",\n    \"body\": \"bar\",\n    \"userId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/posts",
							"host": ["{{baseUrl}}"],
							"path": ["posts"]
						},
						"description": "Creates a new post."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response time is less than 1000ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(1000);",
									"});",
									"",
									"pm.test(\"Response contains submitted fields\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.title).to.eql('foo');",
									"    pm.expect(jsonData.body).to.eql('bar');",
									"    pm.expect(jsonData.userId).to.eql(1);",
									"});",
									"",
									"pm.test(\"Response has a generated id\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"});",
									"",
									"// store the created id for use in later requests",
									"pm.collectionVariables.set(\"createdPostId\", pm.response.json().id);"
								]
							}
						}
					]
				},
				{
					"name": "POST Create Post - Missing Body (Negative)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"foo\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/posts",
							"host": ["{{baseUrl}}"],
							"path": ["posts"]
						},
						"description": "Negative test: creates a post with incomplete data to confirm the API still responds gracefully."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response still returns an id\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "3. PUT Requests",
			"item": [
				{
					"name": "PUT Update Post (id=1)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": 1,\n    \"title\": \"updated title\",\n    \"body\": \"updated body content\",\n    \"userId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/posts/1",
							"host": ["{{baseUrl}}"],
							"path": ["posts", "1"]
						},
						"description": "Updates the post with id = 1."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response time is less than 1000ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(1000);",
									"});",
									"",
									"pm.test(\"Response reflects updated values\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.title).to.eql('updated title');",
									"    pm.expect(jsonData.body).to.eql('updated body content');",
									"});",
									"",
									"pm.test(\"id remains unchanged\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.eql(1);",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "4. DELETE Requests",
			"item": [
				{
					"name": "DELETE Post (id=1)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/posts/1",
							"host": ["{{baseUrl}}"],
							"path": ["posts", "1"]
						},
						"description": "Deletes the post with id = 1."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response time is less than 800ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(800);",
									"});",
									"",
									"pm.test(\"Response body is an empty object\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('object');",
									"    pm.expect(Object.keys(jsonData).length).to.eql(0);",
